table aircraft (
  id bigint -- Primary key
  tail_num varchar -- e.g., 'N806MD'
  aircraft_serial varchar
  aircraft_model_code varchar
  aircraft_engine_code varchar
  year_built bigint
  aircraft_type_id bigint
  aircraft_engine_type_id bigint
  registrant_type_id bigint
  name varchar -- Owner/registrant
  address1 varchar
  address2 varchar
  city varchar
  state varchar
  zip varchar
  region varchar
  county varchar
  country varchar -- Typically 'US'
  certification varchar
  status_code varchar -- 'A' = Active, 'V' = Valid, 'M' = Missing, 'E' = Expired, 'R' = Revoked, 'S' = Suspended
  mode_s_code varchar
  fract_owner varchar
  last_action_date date
  cert_issue_date date
  air_worth_date date

  /* Join relationships */

  join one aircraft_models on aircraft_model_code = aircraft_models.aircraft_model_code
  join many flights on tail_num = flights.tail_num

  /* Dimensions */

  age: 2005 - year_built -- Age in years. Data only goes up to 2005, so using 2005 as "this year" instead of current_date()

  /* Measures */

  avg_age: avg(age)
);
