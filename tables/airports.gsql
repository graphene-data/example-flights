table airports (
  id bigint -- Primary key
  code varchar -- IATA airport code (e.g., 'JFK', 'LAX', 'ORD')
  site_number varchar
  fac_type varchar -- e.g., 'AIRPORT', 'HELIPORT', 'SEAPLANE BASE', 'BALLOONPORT', 'GLIDERPORT', 'STOLPORT', 'ULTRALIGHT'
  fac_use varchar -- 'PU' = Public, 'PR' = Private
  faa_region varchar
  faa_dist varchar
  city varchar
  county varchar
  state varchar
  full_name varchar
  own_type varchar -- 'PU' = Public, 'PR' = Private
  longitude double
  latitude double
  elevation bigint -- Elevation in feet above sea level
  aero_cht varchar
  cbd_dist bigint -- Distance to CBD in miles
  cbd_dir varchar -- Compass direction to CBD (e.g., 'N', 'SW', 'SE')
  act_date varchar
  cert varchar
  fed_agree varchar
  cust_intl varchar
  c_ldg_rts varchar
  joint_use varchar -- 'Y' = yes, 'N' = no
  mil_rts varchar -- 'Y' = yes, 'N' = no
  cntl_twr varchar -- 'Y' = yes, 'N' = no
  major varchar -- 'Y' = yes, 'N' = no

  /* Join relationships */

  join many flights as departures on code = departures.origin
  join many flights as arrivals on code = arrivals.destination
);
